<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EDCF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/SectionTitle"
            android:background="#E7C55B"
            android:text="@string/devices" />

        <!-- Buttons are as large as the logo, with space above, below and between them -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bluetootl_list_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/round_corners"
                android:contentDescription="@string/device_list"
                android:onClick="openBTList"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_devices" />

            <ImageButton
                android:id="@+id/break_connection_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/round_corners"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/disconnect"
                android:onClick="breakBTConnection"
                app:srcCompat="@drawable/ic_disconnect" />

            <TextView
                android:id="@+id/connection_txt"
                style="@style/Label"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/disconnected"
                android:textColor="#FF0303" />

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/ic_logo" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="#E7C55B">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_status" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/status_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/gray_water_tank" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="12dp"
                    android:text="@string/water_level" />

                <TextView
                    android:id="@+id/gray_water_lvl_txt"
                    style="@style/Value"
                    android:text="@string/no_value" />

                <TextView
                    style="@style/Label"
                    android:text="@string/water_temperature" />

                <TextView
                    android:id="@+id/gray_water_lvl_temp"
                    style="@style/Value"
                    android:text="@string/no_value" />

                <!-- Label, actual valve state, then the switch on the same row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:labelFor="@id/open_valve_switch"
                        android:text="@string/open_valve" />

                    <TextView
                        android:id="@+id/valve_state_txt"
                        style="@style/Value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:gravity="end"
                        android:text="@string/no_value" />

                    <Switch
                        android:id="@+id/open_valve_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/open_valve"
                        android:trackTint="#FF0000" />
                </LinearLayout>

                <Switch
                    android:id="@+id/heate_on_light"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:text="@string/heater"
                    android:trackTint="#FF0000" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/clean_water_tank" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="12dp"
                    android:text="@string/water_level" />

                <TextView
                    android:id="@+id/clean_water_lvl_txt"
                    style="@style/Value"
                    android:text="@string/no_value" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/position" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:text="@string/pitch" />

                        <TextView
                            android:id="@+id/pitch_num"
                            style="@style/Value"
                            android:text="@string/no_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:text="@string/roll" />

                        <TextView
                            android:id="@+id/roll_num"
                            style="@style/Value"
                            android:text="@string/no_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:text="@string/yaw" />

                        <TextView
                            android:id="@+id/yaw_num"
                            style="@style/Value"
                            android:text="@string/no_value" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_gray_tank" />

                <Switch
                    android:id="@+id/buzzer_switch"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:text="@string/settings_buzzer" />

                <TextView
                    android:id="@+id/gray_threshold_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/gray_threshold_seek"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="10" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_heating" />

                <Switch
                    android:id="@+id/auto_heating_switch"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:text="@string/settings_auto_heating" />

                <TextView
                    android:id="@+id/heating_threshold_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:id="@+id/heating_threshold_seek"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="4" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
