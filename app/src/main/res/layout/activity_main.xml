<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EDCF"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/SectionTitle"
            android:background="#E7C55B"
            android:text="@string/devices" />

        <!-- Buttons are as large as the logo, with space above, below and between them -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bluetootl_list_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/round_corners"
                android:contentDescription="@string/device_list"
                android:onClick="openBTList"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_devices" />

            <ImageButton
                android:id="@+id/break_connection_btn"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/round_corners"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/disconnect"
                android:onClick="breakBTConnection"
                app:srcCompat="@drawable/ic_disconnect" />

            <!-- Connection state: a pill with a light, coloured by MainActivity. The frame takes the
                 free width, so the pill keeps its own width but a long text is cut, not the logo. -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                tools:ignore="UselessParent">

                <LinearLayout
                    android:id="@+id/connection_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/status_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <View
                        android:id="@+id/connection_light"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/indicator_light" />

                    <TextView
                        android:id="@+id/connection_txt"
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/disconnected"
                        android:textColor="#3A3A3A" />
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/app_name"
                app:srcCompat="@drawable/ic_logo" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:background="#E7C55B"
        app:tabTextAppearance="@style/TabText">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_status" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/status_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/gray_water_tank" />

                <!-- Measurements: label on the left, value on the right, in line with the switches -->
                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/level" />

                    <TextView
                        android:id="@+id/gray_water_lvl_txt"
                        style="@style/Value"
                        android:layout_width="wrap_content"
                        android:text="@string/no_value" />
                </LinearLayout>

                <!-- Label, actual valve state, then the switch on the same row; the switch draws its track
                     12 dp inside its bounds, the negative margin puts the track flush with the values -->
                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="wrap_content"
                        android:labelFor="@id/open_valve_switch"
                        android:text="@string/valve" />

                    <TextView
                        android:id="@+id/valve_state_txt"
                        style="@style/Value"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="8dp"
                        android:gravity="end"
                        android:text="@string/no_value" />

                    <Switch
                        android:id="@+id/open_valve_switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="-12dp"
                        android:contentDescription="@string/valve"
                        android:trackTint="#FF0000" />
                </LinearLayout>

                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/temperature" />

                    <TextView
                        android:id="@+id/gray_water_lvl_temp"
                        style="@style/Value"
                        android:layout_width="wrap_content"
                        android:text="@string/no_value" />
                </LinearLayout>

                <!-- Heater: an indicator light, green when on, red when off, grey without a value -->
                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/heater" />

                    <View
                        android:id="@+id/heate_on_light"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/indicator_light" />
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/clean_water_tank" />

                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/level" />

                    <TextView
                        android:id="@+id/clean_water_lvl_txt"
                        style="@style/Value"
                        android:layout_width="wrap_content"
                        android:text="@string/no_value" />
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/position" />

                <LinearLayout
                    android:layout_marginHorizontal="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:gravity="center"
                            android:text="@string/pitch" />

                        <com.example.tank_manager.TiltView
                            android:id="@+id/pitch_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            app:tiltMode="pitch" />

                        <TextView
                            android:id="@+id/pitch_num"
                            style="@style/Value"
                            android:gravity="center"
                            android:text="@string/no_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:gravity="center"
                            android:text="@string/roll" />

                        <com.example.tank_manager.TiltView
                            android:id="@+id/roll_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            app:tiltMode="roll" />

                        <TextView
                            android:id="@+id/roll_num"
                            style="@style/Value"
                            android:gravity="center"
                            android:text="@string/no_value" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Label"
                            android:gravity="center"
                            android:text="@string/heading" />

                        <com.example.tank_manager.TiltView
                            android:id="@+id/heading_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="4dp"
                            app:tiltMode="heading" />

                        <TextView
                            android:id="@+id/yaw_num"
                            style="@style/Value"
                            android:gravity="center"
                            android:text="@string/no_value" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/settings_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_level_alarm" />

                <Switch
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/buzzer_switch"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:text="@string/settings_buzzer" />

                <TextView
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/gray_threshold_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/gray_threshold_seek"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="10" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_heating" />

                <Switch
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/auto_heating_switch"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:text="@string/settings_auto_heating" />

                <TextView
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/heating_threshold_label"
                    style="@style/Label"
                    android:layout_marginTop="8dp" />

                <SeekBar
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/heating_threshold_seek"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:max="4" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_marginTop="16dp"
                    android:text="@string/settings_clean_filling" />

                <Switch
                    android:layout_marginHorizontal="12dp"
                    android:id="@+id/fill_mode_switch"
                    style="@style/Label"
                    android:layout_height="48dp"
                    android:text="@string/settings_fill_mode" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
