<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EDCF"
    tools:context=".MainActivity">


    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="408dp"
        android:layout_height="123dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/editTextText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:longClickable="false"
            android:textIsSelectable="false"
            android:background="#E7C55B"
            android:ems="10"
            android:fontFamily="monospace"
            android:inputType="text"
            android:text="Devices"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="70dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bluetootl_list_btn"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:background="@drawable/round_corners"
                android:onClick="openBTList"
                app:srcCompat="@drawable/bluetooth" />

            <ImageButton
                android:id="@+id/break_connection_btn"
                android:layout_width="70dp"
                android:layout_height="match_parent"
                android:background="@drawable/round_corners"
                android:onClick="breakBTConnection"
                android:src="@drawable/broken_link" />

        </LinearLayout>

        <TextView
            android:id="@+id/connection_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:longClickable="false"
            android:textIsSelectable="false"
            android:fontFamily="monospace"
            android:text="DISCONNECTED"
            android:textColor="#FF0303"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="408dp"
        android:layout_height="214dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout">

        <LinearLayout
            android:layout_width="399dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/editTextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:background="#F0D06B"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="text"
                android:text="Gray water tank"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editTextText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="text"
                android:text="Water level"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gray_water_lvl_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 %"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/editTextText5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="text"
                android:text="Water temperature"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gray_water_lvl_temp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 °C"
                android:textStyle="bold" />

        </LinearLayout>

        <Switch
            android:id="@+id/open_valve_switch"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:ems="10"
            android:focusable="false"
            android:fontFamily="monospace"
            android:longClickable="false"
            android:onClick="openValve"
            android:showText="true"
            android:text="Open valve"
            android:textIsSelectable="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:trackTint="#FF0000" />

        <Switch
            android:id="@+id/heate_on_light"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:ems="10"
            android:focusable="false"
            android:fontFamily="monospace"
            android:longClickable="false"
            android:showText="true"
            android:clickable="false"
            android:text="Heater"
            android:textIsSelectable="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:trackTint="#FF0000" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="410dp"
        android:layout_height="122dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

            <LinearLayout
                android:layout_width="399dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/editTextText1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:longClickable="false"
                    android:textIsSelectable="false"
                    android:background="#EFCF6A"
                    android:ems="10"
                    android:fontFamily="monospace"
                    android:inputType="text"
                    android:text="Clean water tank"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/editTextText4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:longClickable="false"
                    android:textIsSelectable="false"
                    android:ems="10"
                    android:fontFamily="monospace"
                    android:inputType="text"
                    android:text="Water level"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/clean_water_lvl_txt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0 %" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="405dp"
        android:layout_height="88dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <TextView
            android:id="@+id/editTextText6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:longClickable="false"
            android:textIsSelectable="false"
            android:background="#F0D06A"
            android:ems="10"
            android:fontFamily="monospace"
            android:inputType="text"
            android:text="Position"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pitch_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="number"
                android:text="0°"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/roll_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="number"
                android:text="0°"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yaw_num"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ems="10"
                android:fontFamily="monospace"
                android:inputType="number"
                android:text="0°"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>